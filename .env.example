# Copie para .env.local e preencha. No Render, cadastre as mesmas variáveis em "Environment".

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Senha que protege os seus dados e a sua cota do Gemini. Escolha uma senha forte.
# O app pede essa chave uma vez em cada aparelho (Configurações → Sincronização).
APP_ACCESS_KEY=""

# Banco de dados na nuvem (https://console.upstash.com → Redis → REST API)
# Sem estas duas variáveis, o servidor usa um arquivo local em .data/ (só para desenvolvimento).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcional: porta do servidor (padrão 3000)
# PORT=3000
